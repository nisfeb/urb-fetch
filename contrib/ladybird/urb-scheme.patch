+    // AD-HOC: A page from the urb-fetch gateway shows the urb:// address it was read from.
+    if (auto urb_address = URL::urb_address_for_display(url); urb_address.has_value())
+        return urb_address.release_value();
+
     if (!url.scheme().is_one_of("http"sv, "https"sv))
