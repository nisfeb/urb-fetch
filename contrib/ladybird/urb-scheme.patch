diff --git a/Libraries/LibURL/Urb.cpp b/Libraries/LibURL/Urb.cpp
new file mode 100644
index 00000000..3e1439f0
--- /dev/null
+++ b/Libraries/LibURL/Urb.cpp
@@ -0,0 +1,80 @@
+/*
+ * Copyright (c) 2026, nisfeb <business@nisfeb.com>
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <AK/CharacterTypes.h>
+#include <AK/StringBuilder.h>
+#include <LibURL/Parser.h>
+#include <LibURL/Urb.h>
+#include <stdlib.h>
+
+namespace URL {
+
+static constexpr StringView gateway_host_suffix = ".urb.localhost"sv;
+
+static u16 gateway_port()
+{
+    if (auto const* port = getenv("LADYBIRD_URB_FETCH_PORT")) {
+        if (auto value = StringView { port, strlen(port) }.to_number<u16>(); value.has_value())
+            return *value;
+    }
+    return 8475;
+}
+
+// A ship's name without its sig: lowercase letters and dashes.
+static bool is_ship_name(StringView name)
+{
+    if (name.is_empty())
+        return false;
+    for (auto c : name) {
+        if (!is_ascii_lower_alpha(c) && c != '-')
+            return false;
+    }
+    return true;
+}
+
+static void append_path_query_and_fragment(StringBuilder& builder, URL const& url)
+{
+    builder.append(url.serialize_path());
+    if (auto query = url.query(); query.has_value())
+        builder.appendff("?{}", *query);
+    if (auto fragment = url.fragment(); fragment.has_value())
+        builder.appendff("#{}", *fragment);
+}
+
+Optional<URL> urb_gateway_url(URL const& url)
+{
+    if (url.scheme() != "urb"sv)
+        return {};
+
+    auto host = url.serialized_host();
+    if (!host.starts_with('~') || !is_ship_name(host.substring_view(1)))
+        return {};
+
+    StringBuilder builder;
+    builder.appendff("http://{}{}:{}", host.substring_view(1), gateway_host_suffix, gateway_port());
+    append_path_query_and_fragment(builder, url);
+    return Parser::basic_parse(builder.string_view());
+}
+
+Optional<String> urb_address_for_display(URL const& url)
+{
+    if (url.scheme() != "http"sv || !url.port().has_value() || *url.port() != gateway_port())
+        return {};
+
+    auto host = url.serialized_host();
+    if (!host.ends_with(gateway_host_suffix))
+        return {};
+    auto ship = host.substring_view(0, host.length() - gateway_host_suffix.length());
+    if (!is_ship_name(ship))
+        return {};
+
+    StringBuilder builder;
+    builder.appendff("urb://~{}", ship);
+    append_path_query_and_fragment(builder, url);
+    return builder.to_string_without_validation();
+}
+
+}
diff --git a/Libraries/LibURL/Urb.h b/Libraries/LibURL/Urb.h
new file mode 100644
index 00000000..3459c27c
--- /dev/null
+++ b/Libraries/LibURL/Urb.h
@@ -0,0 +1,24 @@
+/*
+ * Copyright (c) 2026, nisfeb <business@nisfeb.com>
+ *
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#pragma once
+
+#include <AK/Optional.h>
+#include <AK/String.h>
+#include <LibURL/URL.h>
+
+// urb:// addresses name pages published on the Urbit network. They are read through the urb-fetch gateway on this
+// computer (https://github.com/nisfeb/urb-fetch), which serves urb://~ship/path at http://ship.urb.localhost:8475/path.
+// The port is 8475 unless LADYBIRD_URB_FETCH_PORT says otherwise; helper processes only see LADYBIRD_ variables.
+namespace URL {
+
+// The gateway URL for an urb:// URL; empty for anything else.
+Optional<URL> urb_gateway_url(URL const&);
+
+// The urb:// address a gateway URL stands for, for display; empty for anything else.
+Optional<String> urb_address_for_display(URL const&);
+
+}
