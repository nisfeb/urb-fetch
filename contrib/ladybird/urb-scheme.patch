diff --git a/Tests/LibURL/TestURL.cpp b/Tests/LibURL/TestURL.cpp
index e970eb67..430e0845 100644
--- a/Tests/LibURL/TestURL.cpp
+++ b/Tests/LibURL/TestURL.cpp
@@ -11,6 +11,7 @@
 
 #include <LibURL/Parser.h>
 #include <LibURL/URL.h>
+#include <LibURL/Urb.h>
 
 TEST_CASE(basic)
 {
@@ -786,3 +787,25 @@ TEST_CASE(host_is_loopback_or_localhost)
     EXPECT(!host_of("http://example.com"sv).is_loopback_or_localhost());
     EXPECT(!host_of("http://0.0.0.0"sv).is_loopback_or_localhost());
 }
+
+TEST_CASE(urb_gateway)
+{
+    auto gateway = [](StringView input) -> ByteString {
+        auto url = URL::urb_gateway_url(URL::Parser::basic_parse(input).release_value());
+        return url.has_value() ? url->serialize().to_byte_string() : ByteString {};
+    };
+    EXPECT_EQ(gateway("urb://~sampel-palnet/notes/intro?raw#top"sv), "http://sampel-palnet.urb.localhost:8475/notes/intro?raw#top"sv);
+    EXPECT_EQ(gateway("urb://~zod"sv), "http://zod.urb.localhost:8475/"sv);
+    EXPECT_EQ(gateway("urb://zod/x"sv), ""sv);
+    EXPECT_EQ(gateway("urb://~Zod/x"sv), ""sv);
+    EXPECT_EQ(gateway("https://~zod/x"sv), ""sv);
+
+    auto display = [](StringView input) -> ByteString {
+        auto address = URL::urb_address_for_display(URL::Parser::basic_parse(input).release_value());
+        return address.has_value() ? address->to_byte_string() : ByteString {};
+    };
+    EXPECT_EQ(display("http://sampel-palnet.urb.localhost:8475/notes/intro"sv), "urb://~sampel-palnet/notes/intro"sv);
+    EXPECT_EQ(display("http://sampel-palnet.urb.localhost:8080/notes"sv), ""sv);
+    EXPECT_EQ(display("http://a.sampel-palnet.urb.localhost:8475/"sv), ""sv);
+    EXPECT_EQ(display("https://sampel-palnet.urb.localhost:8475/"sv), ""sv);
+}
