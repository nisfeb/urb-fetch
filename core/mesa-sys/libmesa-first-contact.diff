+/* a comet's first contact with a ship that, as stock ames does, drops
+** what an unknown comet sends rather than keeping it for when it has
+** the comet's keys. The ship can't reach the comet for the first 10 s
+** (its galaxy doesn't know the comet's lane yet), so the comet's resends
+** back off. Once the ship has read the comet's proof, its ack must come
+** soon after, not a whole backoff later.
+*/
+static _node* sto_u;    //  the stock-like ship
+static u3_ship sco_u;   //  the comet it drops pokes from
+
+static void
+_stock_step(void)
+{
+  eng_peer* per_u = eng_peer_get(sto_u->eng, sco_u);
+
+  if ( per_u ) {
+    while ( per_u->stl_u ) {
+      eng_out* nex_u = per_u->stl_u->nex_u;
+      c3_free(per_u->stl_u->buf_y);
+      c3_free(per_u->stl_u);
+      per_u->stl_u = nex_u;
+    }
+    per_u->stn_w = 0;
+  }
+}
+
+static void
+_test_comet_stock(_node* nec)
+{
+  mesa_ident ide;
+  mesa_ship  stars[1] = { _ship("~marnec") };
+  c3_y       eny_y[64];
+  _node*     com;
+  c3_d       bon_d, kno_d = 0, don_d = 0;
+
+  for ( c3_w i = 0; i < 64; i++ ) eny_y[i] = (c3_y)(i * 7 + 11);
+  u3_assert( mesa_comet_mine(1, stars, eny_y, 1000000, &ide) );
+  com = _add_node(&ide);
+  sto_u = nec;
+  sco_u[0] = ide.who.lo;
+  sco_u[1] = ide.who.hi;
+  ste_f = _stock_step;
+
+  mesa_flow_open(com->eng, nec->who, &bon_d);
+  _send(com, nec, bon_d, mesa_atom_cord("first contact"));
+  com->drp_w = 100;
+  _run(10000);
+  com->drp_w = 0;
+
+  for ( c3_w i = 0; (i < 3000) && !don_d; i++ ) {
+    eng_peer* per_u = eng_peer_get(nec->eng, sco_u);
+    _run(100);
+    if ( !kno_d && per_u && (c3y == per_u->kno_o) ) kno_d = now_d;
+    if ( _count(com, "done") ) don_d = now_d;
+  }
+  ste_f = 0;
+
+  expect(1 == _count(nec, "plea"), "stock comet plea: %u", _count(nec, "plea"));
+  expect(kno_d && don_d, "stock comet: keys at %" PRIu64 ", done at %" PRIu64,
+         kno_d, don_d);
+  expect(don_d && (don_d - kno_d <= 1000),
+         "stock comet: acked %" PRIu64 " ms after the ship had its keys",
+         don_d - kno_d);
+  _clear(com); _clear(nec);
+}
+
