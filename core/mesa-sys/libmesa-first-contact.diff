+/* eng_req_hurry(): resend our pokes to [per_u] in [del_d] ms, their
+**                  backoff started again
+*/
+void
+eng_req_hurry(mesa_engine* eng, eng_peer* per_u, c3_d del_d)
+{
+  for ( eng_req* req_u = per_u->req_u; req_u; req_u = req_u->nex_u ) {
+    if ( (REQ_ACK == req_u->typ_e) && (req_u->nex_d > eng->now_d + del_d) ) {
+      req_u->nex_d = eng->now_d + del_d;
+      req_u->rto_d = ENG_RTO_MIN;
+    }
+  }
+}
