+/* a comet's first contact with a ship that, as stock ames does, drops
+** what an unknown comet sends rather than keeping it for when it has
+** the comet's keys. The ship can't reach the comet for the first 10 s
+** (its galaxy doesn't know the comet's lane yet), so the comet's resends
+** back off. Once the ship has read the comet's proof, its ack must come
+** soon after, not a whole backoff later.
+*/
+static _node* sto_u;    //  the stock-like ship
+static u3_ship sco_u;   //  the comet it drops pokes from
+
+static void
+_stock_step(void)
+{
+  eng_peer* per_u = eng_peer_get(sto_u->eng, sco_u);
+
+  if ( per_u ) {
+    while ( per_u->stl_u ) {
+      eng_out* nex_u = per_u->stl_u->nex_u;
+      c3_free(per_u->stl_u->buf_y);
+      c3_free(per_u->stl_u);
+      per_u->stl_u = nex_u;
+    }
+    per_u->stn_w = 0;
+  }
+}
+
+static void
+_test_comet_stock(_node* nec)
+{
+  mesa_ident ide;
+  mesa_ship  stars[1] = { _ship("~marnec") };
+  c3_y       eny_y[64];
+  _node*     com;
+  c3_d       bon_d, kno_d = 0, don_d = 0;
+
+  for ( c3_w i = 0; i < 64; i++ ) eny_y[i] = (c3_y)(i * 7 + 11);
+  u3_assert( mesa_comet_mine(1, stars, eny_y, 1000000, &ide) );
+  com = _add_node(&ide);
+  sto_u = nec;
+  sco_u[0] = ide.who.lo;
+  sco_u[1] = ide.who.hi;
+  ste_f = _stock_step;
+
+  mesa_flow_open(com->eng, nec->who, &bon_d);
+  _send(com, nec, bon_d, mesa_atom_cord("first contact"));
+  com->drp_w = 100;
+  _run(10000);
+  com->drp_w = 0;
+
+  for ( c3_w i = 0; (i < 3000) && !don_d; i++ ) {
+    eng_peer* per_u = eng_peer_get(nec->eng, sco_u);
+    _run(100);
+    if ( !kno_d && per_u && (c3y == per_u->kno_o) ) kno_d = now_d;
+    if ( _count(com, "done") ) don_d = now_d;
+  }
+  ste_f = 0;
+
+  expect(1 == _count(nec, "plea"), "stock comet plea: %u", _count(nec, "plea"));
+  expect(kno_d && don_d, "stock comet: keys at %" PRIu64 ", done at %" PRIu64,
+         kno_d, don_d);
+  expect(don_d && (don_d - kno_d <= 1000),
+         "stock comet: acked %" PRIu64 " ms after the ship had its keys",
+         don_d - kno_d);
+  _clear(com); _clear(nec);
+}
+
+/* anyone can read a comet's proof, and each read hurries its pokes:
+** reads over and over must not undo the backoff to a ship that's down
+*/
+static void
+_test_hurry_gap(_node* nec)
+{
+  mesa_ident ide;
+  mesa_ship  stars[1] = { _ship("~marnec") };
+  c3_y       eny_y[64];
+  _node*     com;
+  c3_d       bon_d;
+  u3_ship    nsh_u = { nec->who.lo, nec->who.hi };
+  eng_peer*  per_u;
+  eng_req*   req_u = 0;
+  c3_w       one_w, fir_w, las_w;
+
+  for ( c3_w i = 0; i < 64; i++ ) eny_y[i] = (c3_y)(i * 13 + 5);
+  u3_assert( mesa_comet_mine(1, stars, eny_y, 1000000, &ide) );
+  com = _add_node(&ide);
+
+  nec->off_o = c3y;
+  mesa_flow_open(com->eng, nec->who, &bon_d);
+  _send(com, nec, bon_d, mesa_atom_cord("to a ship that's down"));
+  _run(60000);
+
+  per_u = eng_peer_get(com->eng, nsh_u);
+  for ( eng_req* r = per_u ? per_u->req_u : 0; r; r = r->nex_u ) {
+    if ( REQ_ACK == r->typ_e ) req_u = r;
+  }
+  expect(0 != req_u, "hurry gap: no pending poke");
+
+  if ( req_u ) {
+    //  our galaxy read our proof: everyone is hurried, and each peer's
+    //  own hurry is still there for when it reads the proof itself
+    mesa_engine_wake(com->eng, now_d);
+    eng_req_hurry_all(com->eng, ENG_HURRY_MS);
+    expect(0 == per_u->hur_d, "hurry gap: the galaxy's hurry took the peer's");
+    _run(600);
+    one_w = req_u->try_w;
+    mesa_engine_wake(com->eng, now_d);
+    eng_req_hurry(com->eng, per_u, ENG_HURRY_MS);
+    _run(600);
+    fir_w = req_u->try_w;
+    for ( c3_w i = 0; i < 30; i++ ) {
+      mesa_engine_wake(com->eng, now_d);
+      eng_req_hurry(com->eng, per_u, ENG_HURRY_MS);
+      _run(1000);
+    }
+    las_w = req_u->try_w;
+    expect(fir_w == one_w + 1, "hurry gap: first hurry sent %u", fir_w - one_w);
+    expect(las_w - fir_w <= 6, "hurry gap: %u resends in 30 s", las_w - fir_w);
+  }
+
+  nec->off_o = c3n;
+  _run(5 * 60 * 1000);
+  _clear(com); _clear(nec);
+}
+
+/* the proof's path names its reader, so anyone can claim to be our
+** galaxy or the ship: reads over and over, as both, at worst out of
+** step, hurry a poke to a ship that's down at most twice per
+** ENG_HURRY_GAP, not every read
+*/
+static void
+_test_hurry_flood(_node* nec)
+{
+  mesa_ident ide;
+  mesa_ship  stars[1] = { _ship("~marnec") };
+  c3_y       eny_y[64];
+  _node*     com;
+  c3_d       bon_d;
+  u3_ship    nsh_u = { nec->who.lo, nec->who.hi };
+  eng_peer*  per_u;
+  eng_req*   req_u = 0;
+  c3_w       fir_w, las_w;
+
+  for ( c3_w i = 0; i < 64; i++ ) eny_y[i] = (c3_y)(i * 17 + 3);
+  u3_assert( mesa_comet_mine(1, stars, eny_y, 1000000, &ide) );
+  com = _add_node(&ide);
+
+  nec->off_o = c3y;
+  mesa_flow_open(com->eng, nec->who, &bon_d);
+  _send(com, nec, bon_d, mesa_atom_cord("flooded with reads"));
+  _run(60000);
+
+  per_u = eng_peer_get(com->eng, nsh_u);
+  for ( eng_req* r = per_u ? per_u->req_u : 0; r; r = r->nex_u ) {
+    if ( REQ_ACK == r->typ_e ) req_u = r;
+  }
+  expect(0 != req_u, "hurry flood: no pending poke");
+
+  if ( req_u ) {
+    fir_w = req_u->try_w;
+    //  480 s of reads every 500 ms: the galaxy's alone for the first
+    //  60 s, so its budget and the ship's run half a gap apart
+    for ( c3_w i = 0; i < 960; i++ ) {
+      mesa_engine_wake(com->eng, now_d);
+      eng_req_hurry_all(com->eng, ENG_HURRY_MS);
+      if ( i >= 120 ) {
+        eng_req_hurry(com->eng, per_u, ENG_HURRY_MS);
+      }
+      _run(500);
+    }
+    las_w = req_u->try_w;
+    //  8 hurries at most, each a resend in 500 ms and then the backoff
+    //  from ENG_RTO_MIN for the 60 s to the next: 1+1+2+4+...+32 s, 7
+    //  resends. Unbounded, it would be one every 500 ms, 960.
+    expect(las_w - fir_w <= 8 * 7,
+           "hurry flood: %u resends in 480 s", las_w - fir_w);
+  }
+
+  nec->off_o = c3n;
+  _run(5 * 60 * 1000);
+  _clear(com); _clear(nec);
+}
