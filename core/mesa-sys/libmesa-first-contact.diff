+/* _proof_asked(): someone read our attestation, [pat_c]
+**
+**   A comet's first pokes reach a stock ship before it has the comet's
+**   keys, and it drops them: it reads /pawn/proof, and acks only the
+**   next resend, which the backoff may hold for a minute or more. So
+**   once it has the proof, resend soon. If the reader is our galaxy, it
+**   can forward to us from now on, and the proofs other ships asked for
+**   through it before may have died there: resend to everyone.
+*/
+static void
+_proof_asked(mesa_engine* eng, const c3_c* pat_c)
+{
+  knot_path pax_u;
+  u3_ship   rcv_u;
+  eng_peer* per_u;
+
+  if (  (c3__pawn != u3_ship_rank(eng->our_u))
+     || (c3n == knot_path_split(strlen(pat_c), pat_c, &pax_u))
+     || (10 != pax_u.len_w)
+     || (c3n == knot_seg_is(&pax_u.seg_u[6], "pawn"))
+     || (c3n == knot_seg_is(&pax_u.seg_u[7], "proof"))
+     || (c3n == knot_p_parse(pax_u.seg_u[8].len_z,
+                             pax_u.seg_u[8].str_c, rcv_u)) )
+  {
+    return;
+  }
+
+  if ( (c3y == eng->pin_o) && (c3y == u3_ships_equal(rcv_u, eng->gal_u)) ) {
+    for ( eng_peer_map_itr itr_u = eng_peer_map_first(&eng->per_u);
+          !eng_peer_map_is_end(itr_u);
+          itr_u = eng_peer_map_next(itr_u) )
+    {
+      eng_req_hurry(eng, itr_u.data->val, ENG_HURRY_MS);
+    }
+  }
+  else if ( (per_u = eng_peer_get(eng, rcv_u)) ) {
+    eng_req_hurry(eng, per_u, ENG_HURRY_MS);
+  }
+}
