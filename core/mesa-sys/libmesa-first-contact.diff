+/* eng_req_hurry(): resend our pokes to [per_u] in [del_d] ms, their
+**                  backoff started again, at most once per ENG_HURRY_GAP
+**                  (anyone can read our proof, so it mustn't undo the
+**                  backoff for good)
+*/
+static c3_o
+_req_hurry(mesa_engine* eng, eng_peer* per_u, c3_d del_d)
+{
+  c3_o hur_o = c3n;
+
+  for ( eng_req* req_u = per_u->req_u; req_u; req_u = req_u->nex_u ) {
+    if ( (REQ_ACK == req_u->typ_e) && (req_u->nex_d > eng->now_d + del_d) ) {
+      req_u->nex_d = eng->now_d + del_d;
+      req_u->rto_d = ENG_RTO_MIN;
+      hur_o = c3y;
+    }
+  }
+  return hur_o;
+}
+
+void
+eng_req_hurry(mesa_engine* eng, eng_peer* per_u, c3_d del_d)
+{
+  if ( eng->now_d < per_u->hur_d ) {
+    return;
+  }
+  if ( c3y == _req_hurry(eng, per_u, del_d) ) {
+    per_u->hur_d = eng->now_d + ENG_HURRY_GAP;
+  }
+}
+
+/* eng_req_hurry_all(): resend our pokes to everyone in [del_d] ms, at
+**                      most once per ENG_HURRY_GAP. It leaves each
+**                      peer's own hurry alone: a ship that reads our
+**                      proof just after our galaxy has must still get
+**                      its resend soon.
+*/
+void
+eng_req_hurry_all(mesa_engine* eng, c3_d del_d)
+{
+  if ( eng->now_d < eng->hur_d ) {
+    return;
+  }
+  eng->hur_d = eng->now_d + ENG_HURRY_GAP;
+  for ( eng_peer_map_itr itr_u = eng_peer_map_first(&eng->per_u);
+        !eng_peer_map_is_end(itr_u);
+        itr_u = eng_peer_map_next(itr_u) )
+  {
+    _req_hurry(eng, itr_u.data->val, del_d);
+  }
+}
+
 c3_d
 eng_req_deadline(eng_peer* per_u)
 {
